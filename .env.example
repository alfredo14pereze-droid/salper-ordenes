# Copia este archivo a ".env" y llena los valores desde tu proyecto de Supabase
# (Project Settings → API). El "anon key" es público por diseño (se usa en el navegador),
# no es un secreto de servidor.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Solo para el chat (api/chat.js) — la usa el servidor, NUNCA el navegador.
# Se configura en Vercel (Project Settings → Environment Variables), no hace
# falta en tu .env local salvo que pruebes el chat con `vercel dev`.
ANTHROPIC_API_KEY=sk-ant-...
